enum {{ name }}: {{ type }}
{
{{ cases }}

    /**
     * Get the display label for the timezone.
     *
     * @return {{ type }}
     */
    public function label(): {{ type }}
    {
        return match ($this) {
{{ labels }}
        };
    }

    /**
     * Get the full name or description.
     *
     * @return {{ type }}
     */
    public function name(): {{ type }}
    {
        return match ($this) {
{{ names }}
        };
    }

    /**
     * Get the UTC offset.
     *
     * @return {{ type }}
     */
    public function utc(): {{ type }}
    {
        return match ($this) {
{{ utcs }}
        };
    }

    /**
     * Get all timezone codes.
     *
     * @return {{ type }}[]
     */
    public static function values(): array
    {
        return array_column(self::cases(), 'value');
    }
